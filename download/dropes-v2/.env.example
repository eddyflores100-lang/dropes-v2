# ─────────────────────────────────────────────────────────────────────────────
# Dropes v2 - Environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# Dropea dropshipping API (https://api.dropea.com/graphql/dropshippers)
# Source: your Dropea dropshipper dashboard → API Keys
VITE_DROPEA_API_KEY="your_dropea_api_key_here"

# Dropea shop ID (integer). Find it in the Dropea dashboard URL.
VITE_DROPEA_SHOP_ID="12928"

# Public site URL (used for SEO, sitemap, canonical URLs)
# For GitHub Pages: https://<user>.github.io/<repo>
VITE_PUBLIC_SITE_URL="https://eddyflores100-lang.github.io/dropes-v2"

# GitHub repo name (used by Vite to compute `base` path)
# Change if you deploy to a different repo name. Must match the URL segment.
VITE_REPO_NAME="dropes-v2"

# Optional: override the base path entirely (e.g. "/" for a custom domain)
# Leave commented to use the default `/${VITE_REPO_NAME}/`
# VITE_BASE_PATH="/"

# Optional: Google Search Console verification file (already shipped in /public)
# No env var needed; the HTML file ships with the repo.

# ─────────────────────────────────────────────────────────────────────────────
# SECURITY NOTE
# ─────────────────────────────────────────────────────────────────────────────
# VITE_* variables are inlined into the client bundle by Vite and ARE visible
# to anyone who opens devtools. The Dropea API key is therefore exposed.
#
# For a fully secure setup, do one of the following:
#   1. Run a serverless function (Vercel/Cloudflare/Netlify) that holds the
#      real key and forwards signed requests from the browser.
#   2. Migrate to Next.js 16 and move the call into an API route + server-side
#      rate limiting per IP.
#
# Until then, the key MUST be treated as a low-privilege public key and you
# MUST rotate it if leaked. Add per-domain restrictions in the Dropea dashboard
# if the platform supports it.
# ─────────────────────────────────────────────────────────────────────────────

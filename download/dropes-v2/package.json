{
  "name": "dropes-v2",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Dropes ecommerce - Refactored dropshipping store for ES/PT",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "tsc --noEmit && vite build && tsx scripts/post-build.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "sync": "tsx --env-file=.env scripts/sync-dropea.ts",
    "sitemap": "tsx scripts/build-sitemap.ts",
    "deploy": "npm run build && gh-pages -d dist -b gh-pages -m \"deploy: $(git rev-parse --short HEAD 2>/dev/null || echo manual)\"",
    "deploy:force": "npm run build && gh-pages -d dist -b gh-pages --add --message \"deploy: force\""
  },
  "homepage": "https://eddyflores100-lang.github.io/dropes-v2/",
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "gh-pages": "^6.3.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}

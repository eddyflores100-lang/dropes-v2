{
  "name": "dropes-v2",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Dropes ecommerce - Refactored dropshipping store for ES/PT",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "tsc --noEmit && vite build",
